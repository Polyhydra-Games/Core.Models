# Core.Models local development environment variables
#
# This is a class library with no runtime configuration of its own.
# These variables are only needed if you're reproducing the CI publish
# steps from .github/workflows/publish-nuget.yml locally.

# Optional: version suffix used when packing locally (mirrors CI's PACKAGE_VERSION)
# PACKAGE_VERSION=2.0.0.0-local

# Optional: required only to push packages to GitHub Packages
# GITHUB_TOKEN=

# Optional: required only to push packages to nuget.polyhydragames.com
# BAGET_API_KEY=

# Optional: required only to push packages to nuget.org
# NUGET_API_KEY=
