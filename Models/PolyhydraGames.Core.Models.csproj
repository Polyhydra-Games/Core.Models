<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net8.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageId>PolyhydraGames.Core.Models</PackageId>
		<VersionPrefix>3.0.0</VersionPrefix>
		<Authors>Chris Richmond</Authors>
		<Company>PolyhydraGames</Company>
		<Product>PolyhydraGames Core Models</Product>
		<Description>Shared DTOs, media contracts, identifiers, caching, serialization helpers, and reactive utilities for PolyhydraGames projects.</Description>
		<PackageTags>polyhydragames;models;media;dto;utilities</PackageTags>
		<PackageProjectUrl>https://github.com/lancer1977/Core.Models</PackageProjectUrl>
		<RepositoryUrl>https://github.com/lancer1977/Core.Models</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PolyhydraGames.Core.Models.Test" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>



	<ItemGroup>
		<PackageReference Include="PolyhydraGames.Core.Interfaces" Version="3.0.0.14" />
		<PackageReference Include="PolyhydraGames.Extensions" Version="2.1.2.4" />
		<PackageReference Include="System.Reactive" Version="6.1.0" />
	</ItemGroup>

</Project>
